{
  "schemaVersion": 1,
  "id": "packserver",
  "version": "${version}",
  "name": "Packserver",
  "description": "A Minecraft mod.",
  "authors": [
    {
      "name": "Your Name"
    }
  ],
  "contact": {
    "homepage": "",
    "sources": ""
  },
  "license": "MIT",
  "icon": "assets/packserver/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.fewwan.packserver.fabric.PackserverFabric"
    ],
    "client": [
      "io.github.fewwan.packserver.fabric.PackserverClientFabric"
    ]
  },
  "mixins": [
    "packserver.mixins.json",
    {
      "config": "packserver.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=${java_version}"
  }
}
